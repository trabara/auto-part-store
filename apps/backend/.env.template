STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2

# File storage (MinIO from infra/docker/docker-compose.infra.yml: S3 API on :9002, console on :9001)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medusa-v2
MINIO_ENDPOINT=http://localhost:9002
MINIO_FILE_URL=${MINIO_ENDPOINT}/${MINIO_BUCKET}

# Catalog steward research gateway (packages/domains/automotive/src/queries/web-research.ts)
# Tavily: web search, and reading pages a direct fetch cannot (optional: Wikipedia and direct fetches are free)
TAVILY_API_KEY=
# Identifies the steward to the sites it reads (Wikimedia asks for a contact)
WEB_RESEARCH_USER_AGENT=medusa-erp-catalog-steward/1.0 (contact: admin@example.com)
# Domains never read, comma-separated (empty: none)
WEB_RESEARCH_BLOCKED_DOMAINS=
