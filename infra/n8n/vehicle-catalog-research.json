      "parameters": {
        "toolDescription": "Search Wikipedia (free). Returns article titles, URLs and snippets.",
        "method": "POST",
        "url": "={{ $('Config').first().json.medusa_url }}/admin/vehicle-catalog/research/wiki-search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
