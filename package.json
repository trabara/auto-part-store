{
  "name": "medusa-erp",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "rimraf ./node_modules **/*/node_modules .turbo **/.turbo **/*/.medusa **/*/.next",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "docker:build": "docker compose -f infra/docker/docker-compose.yml build",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.infra.yml --env-file infra/docker/.env up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.infra.yml down",
    "n8n:import": "docker exec medusa_n8n n8n import:workflow --input=/workflows/vehicle-catalog-research.json",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.infra.yml --env-file infra/docker/.env logs -f",
    "check-layout": "node packages/tooling/scripts/src/check-layout.mjs",
    "check-layers": "eslint --config packages/config/eslint/layers.js --no-warn-ignored --quiet packages apps",
    "check-deps": "yarn constraints",
    "gen:module": "node packages/tooling/scripts/src/gen-module.mjs",
    "gen:domain": "node packages/tooling/scripts/src/gen-domain.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@swc/core": "1.12.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "chokidar": "^4.0.3",
    "eslint": "^9.39.5",
    "prettier": "^3.7.4",
    "react-i18next": "^15.7.4",
    "react-router-dom": "6.30.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "turbo": "^2.7.6",
    "typescript": "^5.9.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/domains/*",
    "packages/modules/*",
    "packages/tooling/*",
    "packages/ui/*"
  ],
  "resolutions": {
    "@medusajs/core-flows": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/orchestration": "2.21.2",
    "@medusajs/workflows-sdk": "2.21.2",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "overrides": {
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0"
  }
}
