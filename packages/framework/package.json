{
  "name": "@repo/framework",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./admin": {
      "types": "./dist/cjs/admin/index.d.ts",
      "import": "./dist/esm/admin/index.js",
      "require": "./dist/cjs/admin/index.js"
    },
    "./admin/plugins": {
      "types": "./dist/cjs/admin/plugins/index.d.ts",
      "import": "./dist/esm/admin/plugins/index.js",
      "require": "./dist/cjs/admin/plugins/index.js"
    },
    "./core": {
      "types": "./dist/cjs/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/cjs/core/index.js"
    },
    "./entity": {
      "types": "./dist/cjs/entity/index.d.ts",
      "import": "./dist/esm/entity/index.js",
      "require": "./dist/cjs/entity/index.js"
    },
    "./entity/server": {
      "types": "./dist/cjs/entity/server.d.ts",
      "import": "./dist/esm/entity/server.js",
      "require": "./dist/cjs/entity/server.js"
    },
    "./http": {
      "types": "./dist/cjs/http/index.d.ts",
      "import": "./dist/esm/http/index.js",
      "require": "./dist/cjs/http/index.js"
    },
    "./orm": {
      "types": "./dist/cjs/orm/index.d.ts",
      "import": "./dist/esm/orm/index.js",
      "require": "./dist/cjs/orm/index.js"
    },
    "./utils": {
      "types": "./dist/cjs/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}))\"",
    "dev": "tsc -p tsconfig.build.cjs.json --watch --preserveWatchOutput & tsc -p tsconfig.build.esm.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "zod": "4.2.0"
  },
  "peerDependencies": {
    "@medusajs/admin-bundler": "~2.21.2",
    "@medusajs/admin-sdk": "~2.21.2",
    "@medusajs/framework": "~2.21.2",
    "@medusajs/medusa": "~2.21.2",
    "@medusajs/test-utils": "~2.21.2",
    "react": ">=18",
    "react-router-dom": ">=6.4",
    "vite": ">=5"
  },
  "devDependencies": {
    "@medusajs/admin-bundler": "2.21.2",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/test-utils": "2.21.2",
    "@repo/config": "workspace:*",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.12.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "6.30.6",
    "typescript": "^5.9.2"
  }
}
