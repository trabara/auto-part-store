{
  "name": "@repo/module-fitment",
  "version": "0.0.1",
  "private": true,
  "description": "Fitment module: which product variant fits which vehicle, positions, production windows and conditions",
  "license": "UNLICENSED",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./src/contract/index.ts",
      "default": "./dist/contract/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./src/core/index.ts",
      "default": "./dist/core/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./src/admin/index.ts",
      "default": "./dist/admin/index.js"
    },
    "./admin/ui": {
      "types": "./src/admin/ui/index.ts",
      "default": "./src/admin/ui/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/admin",
    "lint": "eslint .",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent=false --forceExit --passWithNoTests",
    "db:generate": "sh -c 'set -a; . ./.env.test.example; [ -f .env.test ] && . ./.env.test; set +a; module-db-generate'"
  },
  "dependencies": {
    "@repo/framework": "workspace:*",
    "@repo/module-vehicle": "workspace:*",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.0.25",
    "@repo/config": "workspace:*",
    "@repo/dashboard": "workspace:*",
    "@repo/scripts": "workspace:*",
    "@swc/core": "1.12.2",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "^5.101.4",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@medusajs/framework": "~2.21.2",
    "@medusajs/medusa": "~2.21.2"
  },
  "engines": {
    "node": ">=20"
  }
}
