{
  "name": "@repo/plugin-automotive",
  "version": "0.0.1",
  "private": true,
  "description": "Automotive capability (vehicles, fitment) for the Medusa ERP",
  "license": "UNLICENSED",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./links/*": "./.medusa/server/src/links/*.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "check-types": "tsc --noEmit",
    "dev": "plugin-dev-watch . ../../../apps/backend",
    "lint": "eslint .",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent=false --forceExit --passWithNoTests",
    "test": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --forceExit --passWithNoTests",
    "db:generate": "sh -c 'set -a; . ./.env.test.example; [ -f .env.test ] && . ./.env.test; set +a; medusa plugin:db:generate'"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@hookform/resolvers": "^5.4.3",
    "@repo/dashboard": "workspace:*",
    "@repo/framework": "workspace:*",
    "date-fns": "^4.4.0",
    "handlebars": "^4.7.8",
    "lodash": "^4.18.1",
    "lucide-react": "^0.563.0",
    "react-hook-form": "^7.83.0"
  },
  "devDependencies": {
    "@medusajs/admin-bundler": "2.21.2",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/test-utils": "2.21.2",
    "@medusajs/ui": "4.0.25",
    "@repo/config": "workspace:*",
    "@repo/scripts": "workspace:*",
    "@swc/core": "1.12.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "chokidar": "^4.0.3",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^5.4.14"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "~2.21.2",
    "@medusajs/framework": "~2.21.2",
    "@medusajs/icons": "~2.21.2",
    "@medusajs/medusa": "~2.21.2",
    "@medusajs/ui": "~4.0.25"
  },
  "engines": {
    "node": ">=20"
  }
}
